PORT=3005

DATABASE_URL=postgresql://eventhub:eventhub@localhost:5434/notifications_db

# Debe ser IDÉNTICO al INTERNAL_AUTH_SECRET de api-gateway.
INTERNAL_AUTH_SECRET=change-me-in-each-environment

RABBITMQ_URL=amqp://eventhub:eventhub@localhost:5674

AUTH_SERVICE_URL=http://localhost:3001
EVENTS_SERVICE_URL=http://localhost:3002
ORDERS_SERVICE_URL=http://localhost:3004

# Fase B (notificaciones reales) — cuenta gratis en resend.com, sin
# necesidad de tarjeta ni dominio propio verificado.
RESEND_API_KEY=re_change-me
EMAIL_FROM=Event Hub <onboarding@resend.dev>

# Notificaciones push (2026-09-29) — cuenta de servicio de Firebase
# (consola de Firebase > Configuración del proyecto > Cuentas de servicio
# > Generar nueva clave privada). Sin esto, el push queda deshabilitado
# pero el email sigue andando normal — ver PushService.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
