PORT=3004

DATABASE_URL=postgresql://eventhub:eventhub@localhost:5434/orders_db

# Debe ser IDÉNTICO al INTERNAL_AUTH_SECRET de api-gateway.
INTERNAL_AUTH_SECRET=change-me-in-each-environment

RABBITMQ_URL=amqp://eventhub:eventhub@localhost:5674

TICKETS_SERVICE_URL=http://localhost:3003
EVENTS_SERVICE_URL=http://localhost:3002

# Poller del outbox (premisa 8): cada cuánto intenta publicar eventos pendientes.
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_MAX_ATTEMPTS=5

# Fase D (#20) — Wompi (Mercado Pago quedó bloqueado en un error de
# sandbox sin diagnóstico posible). Cuenta de PRUEBA (sandbox), persona
# natural sin Cámara de Comercio. Las 4 llaves salen del dashboard de
# Wompi con "Activar modo de pruebas" activo (prefijo pub_test_/prv_test_/
# test_events_/test_integrity_).
WOMPI_PUBLIC_KEY=pub_test_change-me
WOMPI_PRIVATE_KEY=prv_test_change-me
WOMPI_EVENTS_SECRET=test_events_change-me
WOMPI_INTEGRITY_SECRET=test_integrity_change-me
# Sandbox y producción son la misma API — solo cambia esta base URL (ver
# WompiClientService). Cambiar a https://production.wompi.co/v1 recién
# cuando las llaves de arriba sean pub_prod_/prv_prod_.
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1

# Adónde redirige el WebView de Wompi al terminar (páginas
# /orders/checkout-return/*). El WebView corre en el celular con acceso a
# internet normal, NO a la LAN — a diferencia de API_HOST en la app (que
# sí puede ser la IP LAN), esto necesita ser alcanzable desde internet de
# verdad. En desarrollo, un túnel público (cloudflared/ngrok).
API_PUBLIC_URL=http://localhost:3010

# A diferencia de Mercado Pago, Wompi NO recibe la URL del webhook como
# parámetro del checkout — se configura UNA VEZ en su dashboard
# ("Eventos" → URL de eventos), a mano: <API_PUBLIC_URL>/orders/webhooks/wompi.
