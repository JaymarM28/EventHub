generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  zoneId        String
  reservationId String
  quantity      Int         @default(1) // Fase A: varios boletos por orden
  /// Fase 2 (asiento individual): butacas puntuales de esta orden — vacío
  /// para órdenes "por cupo" (como siempre funcionó). `quantity` sigue
  /// siendo la cantidad real de boletos en ambos casos (== seatIds.length
  /// cuando no está vacío), no se duplica esa info en otro campo.
  seatIds       String[]    @default([])
  amount        Decimal     @db.Decimal(10, 2) // TOTAL (precio unitario × quantity), no unitario
  /// Fase D (#20): moneda del evento en el momento de la compra — viaja
  /// desde events-service vía la reserva (ver TicketsClientService).
  currency      String      @default("COP")
  /// Id de la preferencia de Checkout Pro (Mercado Pago) — legado, ya no se
  /// escribe (Fase D se migró a Wompi, ver `wompiTransactionId`). Se deja
  /// nullable sin backfill para no perder trazabilidad de órdenes viejas.
  mercadoPagoPreferenceId String?
  /// Id del pago de Mercado Pago — legado, mismo criterio que el campo de
  /// arriba.
  mercadoPagoPaymentId    String? @unique
  /// Id de la transacción de Wompi — se completa recién cuando el webhook
  /// de eventos confirma el pago (tras re-consultar la API de Wompi, nunca
  /// confiando en el body del evento solo). Es la clave real de
  /// idempotencia junto con el chequeo de `status` (ver
  /// OrdersService.markPaid).
  wompiTransactionId      String? @unique
  /// #23 — código aplicado (mayúsculas, tal como se canjeó en
  /// events-service) y el monto que se descontó, ambos nullable: la
  /// mayoría de las órdenes no usan ninguno. Solo trazabilidad — el canje
  /// real (usedCount) vive en events-service, acá no hay lógica, solo el
  /// registro de qué se aplicó a ESTA orden.
  discountCode   String?
  discountAmount Decimal? @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("orders")
}

/// Patrón transactional outbox (premisa 8 de DESIGN.md): la confirmación
/// del pago y esta fila se escriben en la MISMA transacción de Postgres.
/// Un poller aparte (OutboxPublisherService) las lee y publica a RabbitMQ
/// con reintento/backoff — así un fallo de RabbitMQ justo después del pago
/// nunca pierde el evento silenciosamente.
model OutboxEvent {
  id          String    @id // == eventId del EventEnvelope
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([publishedAt])
  @@map("outbox_events")
}
