generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  /// #22 — solo alcanzable desde PAID (ver OrdersService.refund). Reembolso
  /// de la orden completa, sin parcial (decisión del usuario) — una orden
  /// con varios boletos (Fase A) se reembolsa/anula entera o nada.
  REFUNDED
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  zoneId        String
  reservationId String
  quantity      Int         @default(1) // Fase A: varios boletos por orden
  /// Fase 2 (asiento individual): butacas puntuales de esta orden — vacío
  /// para órdenes "por cupo" (como siempre funcionó). `quantity` sigue
  /// siendo la cantidad real de boletos en ambos casos (== seatIds.length
  /// cuando no está vacío), no se duplica esa info en otro campo.
  seatIds       String[]    @default([])
  amount        Decimal     @db.Decimal(10, 2) // TOTAL (precio unitario × quantity), no unitario
  /// Fase D (#20): moneda del evento en el momento de la compra — viaja
  /// desde events-service vía la reserva (ver TicketsClientService).
  currency      String      @default("COP")
  /// Id de la preferencia de Checkout Pro (Mercado Pago) — legado, ya no se
  /// escribe (Fase D se migró a Wompi, ver `wompiTransactionId`). Se deja
  /// nullable sin backfill para no perder trazabilidad de órdenes viejas.
  mercadoPagoPreferenceId String?
  /// Id del pago de Mercado Pago — legado, mismo criterio que el campo de
  /// arriba.
  mercadoPagoPaymentId    String? @unique
  /// Id de la transacción de Wompi — se completa recién cuando el webhook
  /// de eventos confirma el pago (tras re-consultar la API de Wompi, nunca
  /// confiando en el body del evento solo). Es la clave real de
  /// idempotencia junto con el chequeo de `status` (ver
  /// OrdersService.markPaid).
  wompiTransactionId      String? @unique
  /// #23 — código aplicado (mayúsculas, tal como se canjeó en
  /// events-service) y el monto que se descontó, ambos nullable: la
  /// mayoría de las órdenes no usan ninguno. Solo trazabilidad — el canje
  /// real (usedCount) vive en events-service, acá no hay lógica, solo el
  /// registro de qué se aplicó a ESTA orden.
  discountCode   String?
  discountAmount Decimal? @db.Decimal(10, 2)
  /// #22 — id del reembolso en Wompi (Refunds V2) y cuándo se aplicó.
  /// Ambos nullable: la inmensa mayoría de las órdenes nunca se reembolsan.
  wompiRefundId String?
  refundedAt    DateTime?
  /// #24 (modelo de negocio, TODOS.md #13) — porción de `amount` que es el
  /// cargo por servicio de la plataforma (comprador lo paga, organizador
  /// nunca lo ve descontado). `amount` sigue siendo el TOTAL cobrado al
  /// comprador (precio de zona + este cargo); lo que se le debe al
  /// organizador es `amount - serviceFeeAmount`. Default 0 para no romper
  /// filas viejas de antes de esta migración.
  serviceFeeAmount Decimal @db.Decimal(10, 2) @default(0)
  /// Null = todavía no se le liquidó al organizador su parte de esta orden.
  /// Se completa recién cuando `PayoutsService.settle` la agrupa en un
  /// Payout — antes de eso, la orden PAID sigue "pendiente de liquidar".
  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id])
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([payoutId])
  @@map("orders")
}

enum PayoutStatus {
  /// No se usa todavía (ver TODOS.md #13) — reservado para cuando se
  /// automatice vía la API de Payouts de Wompi (que liquida async, como el
  /// pago original) en vez de crear el Payout directamente en SETTLED.
  PENDING
  SETTLED
}

enum BankAccountType {
  SAVINGS
  CHECKING
}

/// #24 — datos bancarios del organizador para poder pagarle su parte de las
/// ventas. Uno por organizador (self-service, lo carga él mismo desde el
/// admin panel) — sin historial de cambios: si cambia de cuenta, se
/// sobreescribe (no hay auditoría de "cuenta anterior" en esta versión,
/// mismo criterio de simplicidad que otros recursos sin historial del
/// proyecto).
model OrganizerPayoutAccount {
  id            String          @id @default(uuid())
  organizerId   String          @unique
  accountType   BankAccountType
  accountNumber String
  /// Código del banco tal como lo pide la API de Payouts de Wompi — no se
  /// valida contra una lista propia, el organizador lo tipea.
  bankCode      String
  /// Solo para mostrar en el admin panel (evita otro join/llamada nada más
  /// para un nombre legible) — Wompi solo necesita `bankCode`.
  bankName      String
  legalIdType   String
  legalId       String
  fullName      String
  email         String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("organizer_payout_accounts")
}

/// #24 — agrupa las órdenes PAID de un organizador que se liquidaron
/// juntas. MANUAL por ahora (ver TODOS.md #13): todavía no dispara la API
/// de Payouts de Wompi, `externalReference` es el comprobante de la
/// transferencia que se hizo por fuera de la plataforma — automatizar esto
/// queda pendiente de confirmar fees/límites con Wompi.
model Payout {
  id                String       @id @default(uuid())
  organizerId       String
  /// Neto pagado = suma de (amount - serviceFeeAmount) de las órdenes
  /// incluidas — nunca incluye el cargo por servicio, que es ingreso de la
  /// plataforma, no del organizador.
  totalAmount       Decimal      @db.Decimal(10, 2)
  ordersCount       Int
  status            PayoutStatus @default(SETTLED)
  externalReference String?
  notes             String?
  createdAt         DateTime     @default(now())
  settledAt         DateTime?
  orders            Order[]

  @@index([organizerId])
  @@map("payouts")
}

/// Patrón transactional outbox (premisa 8 de DESIGN.md): la confirmación
/// del pago y esta fila se escriben en la MISMA transacción de Postgres.
/// Un poller aparte (OutboxPublisherService) las lee y publica a RabbitMQ
/// con reintento/backoff — así un fallo de RabbitMQ justo después del pago
/// nunca pierde el evento silenciosamente.
model OutboxEvent {
  id          String    @id // == eventId del EventEnvelope
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([publishedAt])
  @@map("outbox_events")
}
