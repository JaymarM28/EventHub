PORT=3001

# Apunta a la base auth_db del Postgres levantado en docker-compose (raíz del monorepo)
DATABASE_URL=postgresql://eventhub:eventhub@localhost:5434/auth_db

JWT_SECRET=change-me-in-each-environment
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Solo lo usa POST /internal/users (creación de cuentas STAFF desde
# events-service) — debe ser IDÉNTICO al INTERNAL_AUTH_SECRET de
# api-gateway y de los demás servicios internos.
INTERNAL_AUTH_SECRET=change-me-in-each-environment

NOTIFICATIONS_SERVICE_URL=http://localhost:3005

# Host público desde el que se abre el link de verificación de email (va
# DENTRO del correo, así que si probás desde el celular por wifi debe ser
# la IP LAN de la Mac, no localhost — mismo gotcha que API_HOST en mobile).
API_PUBLIC_URL=http://localhost:3010
