PORT=3003

DATABASE_URL=postgresql://eventhub:eventhub@localhost:5434/tickets_db

# Debe ser IDÉNTICO al INTERNAL_AUTH_SECRET de api-gateway.
INTERNAL_AUTH_SECRET=change-me-in-each-environment

RABBITMQ_URL=amqp://eventhub:eventhub@localhost:5674

REDIS_HOST=localhost
REDIS_PORT=6381

# Cuánto dura una reserva antes de expirar (minutos).
RESERVATION_TTL_MINUTES=10

# Secreto para firmar el contenido del QR (compartido con access-service, paso 7).
TICKET_QR_SECRET=change-me-in-each-environment

# Fase E (transferencia de boleto): busca al destinatario por email antes de
# reasignar el userId del ticket.
AUTH_SERVICE_URL=http://localhost:3001
