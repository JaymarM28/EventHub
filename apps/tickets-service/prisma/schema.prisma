generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Read-model local, sincronizado desde events-service vía el evento
/// event.created (primer consumidor real, ver ZonesSyncConsumer). No hay FK
/// cross-servicio — cada servicio es dueño de su propia copia de los datos
/// que necesita.
model EventZone {
  id        String   @id // mismo id que la zona en events-service
  eventId   String
  name      String
  price     Decimal  @db.Decimal(10, 2)
  /// Fase D (#20, pagos reales): denormalizado desde Event.currency —
  /// orders-service lo necesita para crear el PaymentIntent de Stripe en
  /// la moneda correcta, y solo llega hasta acá vía la reserva (ver
  /// ReservationsService.reserve → orders-service/tickets-client.ts).
  currency  String   @default("COP")
  capacity  Int
  syncedAt  DateTime @default(now())

  @@map("event_zones")
}

/// Read-model local de las butacas de una zona (fuente de verdad:
/// events-service, ver Seat en su schema.prisma) — sincronizado vía
/// event.updated cuando el organizador genera butacas (ZonesConsumer). Sin
/// esto, cada reserva de asiento tendría que llamarle a events-service en
/// vivo durante el checkout, la misma razón por la que EventZone existe.
model Seat {
  id         String @id // mismo id que en events-service
  zoneId     String
  rowLabel   String
  seatNumber Int

  @@index([zoneId])
  @@map("seats")
}

/// El boleto confirmado — la fuente de verdad contra sobreventa es el COUNT
/// de esta tabla dentro de una transacción con lock de fila sobre EventZone
/// (ver TicketsService.confirmFromOrder). La reserva en Redis es un "soft
/// hold" para UX rápida, no la garantía dura (premisa 6 de DESIGN.md).
model Ticket {
  id            String    @id @default(uuid())
  zoneId        String
  userId        String
  orderId       String
  reservationId String
  qrToken       String    @unique
  createdAt     DateTime  @default(now())
  /// null = sin usar. Se marca de forma atómica (updateMany con
  /// `scannedAt: null` en el where) al validar en la puerta — evita que dos
  /// escaneos concurrentes del mismo boleto pasen ambos (paso 7).
  scannedAt     DateTime?
  /// Fase E: etiqueta informativa para "asignar boletos de una compra
  /// grupal a amigos" — no cambia el dueño real (userId) ni requiere que
  /// el amigo tenga cuenta, solo identifica para quién es cada boleto
  /// dentro de una orden con quantity>1. Editable solo por el dueño.
  assignedToName String?
  /// Fase 2 (asiento individual): null para boletos "por cupo" (zonas sin
  /// Seats generadas — como siempre funcionó). El `@unique` ES la garantía
  /// dura anti-doble-venta de una butaca puntual: dos transacciones
  /// intentando crear un Ticket para el mismo seatId, Postgres rechaza la
  /// segunda con una violación de constraint — no hace falta un
  /// `SELECT...FOR UPDATE` como en la zona (confirmFromOrder), acá el
  /// índice único lo garantiza solo, sin lock manual.
  seatId String? @unique
  /// #22 — null = boleto vigente. Se marca al consumir order.refunded
  /// (TicketsConsumer) — ver ScansService.scan() para el estado
  /// REFUNDED, distinto de INVALID/ALREADY_USED, que rechaza el escaneo.
  refundedAt DateTime?

  @@index([zoneId])
  @@index([userId])
  @@map("tickets")
}

/// Contrato de idempotencia (premisa 7): antes de procesar un evento
/// consumido, verificar que su eventId no esté aquí; después de procesarlo
/// con éxito, insertarlo en la MISMA transacción que el efecto de negocio.
model ProcessedEvent {
  eventId     String   @id
  eventType   String
  processedAt DateTime @default(now())

  @@map("processed_events")
}

/// Lista de espera (#11, 2026-09-30) — un comprador se anota cuando una
/// zona está agotada; `notifiedAt` se completa cuando un reembolso libera
/// cupo y le toca el turno (ver WaitlistService.notifyFreedSlots), en
/// orden FIFO por `createdAt`. Sin "hold" reservado para esta persona
/// específica en esta v1 (decisión de simplicidad) — el aviso le da la
/// MISMA oportunidad de comprar que cualquiera, solo que se entera primero.
model WaitlistEntry {
  id         String    @id @default(uuid())
  zoneId     String
  userId     String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([zoneId, userId])
  @@index([zoneId, notifiedAt])
  @@map("waitlist_entries")
}
