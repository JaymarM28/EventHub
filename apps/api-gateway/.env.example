PORT=3010

# Debe ser IDÉNTICO al JWT_SECRET de auth-service — el gateway valida los
# tokens que auth-service emite.
JWT_SECRET=change-me-in-each-environment

# Debe ser IDÉNTICO en todos los servicios internos (ver packages/internal-auth).
INTERNAL_AUTH_SECRET=change-me-in-each-environment

# URLs de los microservicios internos. Se agregan a medida que se construyen.
AUTH_SERVICE_URL=http://localhost:3001
EVENTS_SERVICE_URL=http://localhost:3002
TICKETS_SERVICE_URL=http://localhost:3003
ORDERS_SERVICE_URL=http://localhost:3004
NOTIFICATIONS_SERVICE_URL=http://localhost:3005

# Consumidor de ticket.issued para las actualizaciones en vivo del
# admin panel (DashboardGateway/DashboardConsumer).
RABBITMQ_URL=amqp://eventhub:eventhub@localhost:5674
