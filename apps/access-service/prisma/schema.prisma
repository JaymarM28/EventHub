generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanResult {
  VALID
  ALREADY_USED
  INVALID
  DEGRADED
  FORBIDDEN
}

/// Read-model local, sincronizado desde events-service vía event.created
/// (organizerId, autorizado automáticamente a escanear su propio evento) y
/// event.staff-assigned (mismo patrón que EventZone en tickets-service —
/// sin esto, el escaneo dependería en vivo de que events-service esté
/// arriba, TODOS.md #4). Upsert por (eventId, userId) — naturalmente
/// idempotente, no necesita ProcessedEvent (igual razonamiento que la sync
/// de zonas, ver DESIGN.md contrato de idempotencia).
model EventAccess {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_access")
}

/// Auditoría de cada intento de escaneo, válido o no (DESIGN.md paso 7:
/// "control de duplicados/fraude básico"). tickets-service es la fuente de
/// verdad sobre si un boleto fue usado (scannedAt) — este log es solo para
/// visibilidad/auditoría del lado de la puerta, no una segunda fuente de
/// verdad que pueda desincronizarse.
model ScanLog {
  id         String     @id @default(uuid())
  ticketId   String?
  result     ScanResult
  reason     String?
  scannedBy  String
  createdAt  DateTime   @default(now())

  @@index([ticketId])
  @@map("scan_logs")
}
