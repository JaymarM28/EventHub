generator client {
  provider = "prisma-client-js"
  // Output propio por servicio — ver el comentario equivalente en
  // apps/auth-service/prisma/schema.prisma (pnpm dedupea @prisma/client a
  // una sola ubicación física entre servicios sin esto).
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Fase C (#19, búsqueda y filtros): MUSICA/DEPORTES/TEATRO/CONFERENCIA/
/// FESTIVAL/OTRO — lista fija a propósito, un select en la UI es más simple
/// de filtrar que texto libre. Si hace falta una categoría nueva más
/// adelante, se agrega acá.
enum EventCategory {
  MUSICA
  DEPORTES
  TEATRO
  CONFERENCIA
  FESTIVAL
  OTRO
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  venue       String
  /// Nullable a propósito: eventos creados ANTES de Fase C no tienen
  /// ciudad/categoría y no vale la pena forzar un backfill inventado —
  /// simplemente no aparecen si alguien filtra por esto. CreateEventDto
  /// SÍ los exige para eventos nuevos de acá en adelante.
  city        String?
  category    EventCategory?
  /// Fase D (#20, pagos reales): código ISO 4217 de 3 letras. Default COP
  /// a propósito ("por ahora COP, pero según la región" — decisión del
  /// usuario) — vive en el evento, no fijo en código, para que el día que
  /// haya organizadores en otro país puedan elegir la moneda de SU evento
  /// sin otra migración. Stripe trata algunas monedas (COP incluida) como
  /// "cero decimales" — ver StripeClientService en orders-service, ahí se
  /// decide si el monto se multiplica ×100 o se manda tal cual según esto.
  currency    String   @default("COP")
  startsAt    DateTime
  organizerId String // userId del token — no hay FK cross-DB entre servicios
  /// Fase F (#41, imágenes de evento): URL directa nada más, sin subida de
  /// binarios — el organizador ya aloja la imagen donde sea (no hay bucket
  /// propio todavía, ver DESIGN.md #41 para la decisión). Ambos nullable
  /// a propósito: eventos existentes no tienen imagen y no vale la pena
  /// inventar un backfill, igual criterio que city/category en Fase C.
  coverImageUrl     String?
  galleryImageUrls  String[] @default([])
  /// Fase C (#18, mapa de la locación): geocodificadas automáticamente a
  /// partir de venue+city al crear/editar el evento (ver GeocodingService),
  /// nunca pedidas al organizador a mano. Ambas nullable: geocoding es
  /// best-effort (puede no encontrar la dirección, o Nominatim puede estar
  /// caído) — un evento sin coordenadas simplemente no muestra el mapa,
  /// nunca bloquea la creación/edición del evento por esto.
  latitude          Float?
  longitude         Float?
  /// Dirección completa devuelta por el geocoder (Nominatim `display_name`)
  /// — más precisa que "venue, city" tipeado por el organizador, útil para
  /// mostrar bajo el mapa. Mismo criterio nullable/best-effort que lat/lng.
  address           String?
  /// Fase G (mapa de establecimiento): opcional y aditivo a propósito,
  /// mismo criterio que city/coverImageUrl arriba — eventos existentes NO
  /// apuntan a un Venue del catálogo (siguen mostrando solo el texto libre
  /// de `venue`), y no vale la pena inventar un backfill. Un evento nuevo
  /// puede elegir un Venue del maestro para heredar su mapa de secciones.
  venueId     String?
  venueRef    Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  zones       Zone[]
  staff       EventStaff[]
  discountCodes DiscountCode[]
  /// #22 — cuándo se canceló (null = evento activo). Sin un enum de status
  /// separado a propósito: "cancelado" es el único estado excepcional que
  /// existe hoy, y un timestamp nullable ya responde "¿está cancelado?" Y
  /// "¿desde cuándo?" sin una migración de datos para los eventos viejos.
  cancelledAt DateTime?
  /// Notificaciones push (2026-09-29): cuándo se publicó el recordatorio
  /// "tu evento es pronto" (null = todavía no) — ver EventRemindersService.
  /// Sin esto, un mismo evento podría notificarse más de una vez si el
  /// cron corre más de una vez dentro de la ventana de 23-25h antes del
  /// evento (ej. tras un reinicio del servicio).
  reminderSentAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
  @@index([category])
  @@map("events")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

/// #23 — creados por el organizador, uno por evento (nunca globales a
/// propósito, decisión del usuario 2026-09-26: acotar el "blast radius" de
/// un código filtrado/abusado a un solo evento). `maxUses` nullable =
/// ilimitado. El canje real (incrementar `usedCount`) lo hace
/// `redeem()` en una transacción con `SELECT ... FOR UPDATE` — mismo
/// patrón que la reserva de zonas en tickets-service, para que dos
/// canjes concurrentes del último uso disponible no sobrepasen `maxUses`.
model DiscountCode {
  id        String       @id @default(uuid())
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code      String
  type      DiscountType
  /// PERCENTAGE: 0-100. FIXED: monto en la moneda del evento.
  value     Decimal      @db.Decimal(10, 2)
  maxUses   Int?
  usedCount Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Único POR EVENTO, no global — el mismo texto de código puede existir
  // en dos eventos distintos sin chocar.
  @@unique([eventId, code])
  @@index([eventId])
  @@map("discount_codes")
}

model Zone {
  id       String @id @default(uuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name     String
  price    Decimal @db.Decimal(10, 2)
  capacity Int
  /// Vínculo opcional al polígono del mapa de establecimiento que
  /// representa esta zona (ver VenueSection). Nunca cambia el modelo de
  /// venta: sigue siendo "zona con cupo", esto solo le agrega una forma
  /// visual. Se valida en el service que la sección pertenezca al mismo
  /// Venue que el evento (no hay esa garantía a nivel de FK cruzando
  /// Event → Venue → VenueSection).
  venueSectionId String?
  venueSection   VenueSection? @relation(fields: [venueSectionId], references: [id], onDelete: SetNull)

  seats    Seat[]

  @@index([eventId])
  @@index([venueSectionId])
  @@map("zones")
}

/// Fase 2 (asiento individual, opcional por zona): butaca dentro de una
/// zona. Se genera en bloque (fila × asientos por fila, ver
/// EventsService.generateSeats) — nunca se dibuja/carga una por una. Una
/// Zone puede seguir vendiendo "por cupo" sin ninguna Seat, exactamente
/// como hoy; si tiene Seats, tickets-service pasa a vender por butaca
/// puntual (ver Ticket.seatId en tickets-service/prisma/schema.prisma).
/// events-service es la fuente de verdad de ESTE catálogo (qué butacas
/// existen); tickets-service mantiene su propia copia sincronizada vía
/// event.updated, mismo patrón que EventZone — nunca sabe "quién puede
/// generar butacas", solo "qué butacas existen y cuáles están vendidas".
model Seat {
  id         String @id @default(uuid())
  zoneId     String
  zone       Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  rowLabel   String
  seatNumber Int

  @@unique([zoneId, rowLabel, seatNumber])
  @@index([zoneId])
  @@map("seats")
}

/// Quién puede escanear el control de acceso de este evento, más allá del
/// propio organizador (TODOS.md #4). Se crea al llamar
/// POST /events/:id/staff — dispara la creación de la cuenta en
/// auth-service y emite event.staff-assigned, que access-service consume
/// para mantener su propia tabla local (mismo patrón que la sync de zonas
/// en tickets-service, sin FK cross-servicio).
model EventStaff {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String // id devuelto por auth-service al crear la cuenta
  email     String // denormalizado desde auth-service — solo para mostrar
                    // la lista de staff en el admin panel sin otro viaje
                    // de red; nunca es la fuente de verdad de identidad.
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_staff")
}

/// Catálogo de plataforma (Fase de administración, decidida 2026-09-17):
/// administrado por SUPER_ADMIN, NO todavía ligado a Event por FK — un
/// organizador sigue tipeando `Event.venue` como texto libre por ahora.
/// La integración real (elegir un Venue al crear un evento, con
/// coordenadas para el mapa de Fase C #18) queda para cuando se construya
/// esa fase; v1 de este catálogo solo necesita existir y ser administrable.
model Venue {
  id        String   @id @default(uuid())
  name      String
  address   String
  capacity  Int?
  /// Imagen de fondo del mapa de secciones (ej. el plano del estadio/arena)
  /// — mismo criterio que Event.coverImageUrl: URL directa, sin subida de
  /// binarios propia. Nullable: un establecimiento puede existir en el
  /// catálogo sin tener todavía un mapa cargado.
  mapImageUrl String?
  sections  VenueSection[]
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("venues")
}

/// Un polígono clickeable sobre `Venue.mapImageUrl` (ej. "Platea Norte",
/// "Palco VIP"). No es el modelo de venta — eso lo sigue siendo Zone,
/// vía Zone.venueSectionId — esto es puramente la forma visual.
model VenueSection {
  id      String @id @default(uuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name    String
  /// Puntos del polígono en coordenadas normalizadas 0.0–1.0 (relativas al
  /// ancho/alto de la imagen, no píxeles absolutos) — así el mapa se ve
  /// igual sin importar el tamaño de pantalla o de la imagen subida.
  /// Formato: [[x0,y0],[x1,y1],...], mínimo 3 puntos (validado en el DTO).
  points  Json
  zones   Zone[]

  @@index([venueId])
  @@map("venue_sections")
}
