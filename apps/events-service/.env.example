PORT=3002

DATABASE_URL=postgresql://eventhub:eventhub@localhost:5434/events_db

# Debe ser IDÉNTICO al INTERNAL_AUTH_SECRET de api-gateway.
INTERNAL_AUTH_SECRET=change-me-in-each-environment

RABBITMQ_URL=amqp://eventhub:eventhub@localhost:5674

# Usado por POST /events/:id/staff para crear la cuenta de STAFF.
AUTH_SERVICE_URL=http://localhost:3001

# Usado por GET /events/:id/dashboard (admin panel) para el conteo de
# boletos vendidos por zona.
TICKETS_SERVICE_URL=http://localhost:3003

# Cloudflare R2 (compatible con la API de S3) — subida de imágenes reales
# (mapa de establecimiento, portada/galería de evento) en vez de pegar una
# URL a mano. Crear el bucket en el dashboard de Cloudflare > R2, y un
# API token con permiso "Object Read & Write" sobre ESE bucket.
# R2_ENDPOINT: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL pública desde la que se sirven los archivos subidos — el dominio
# r2.dev que Cloudflare da gratis por bucket, o un dominio propio si
# conectaste uno vía Custom Domains.
R2_PUBLIC_BASE_URL=
