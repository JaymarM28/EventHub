# Postgres
# Puerto host 5433 (no 5432) — evita chocar con un Postgres nativo u otro
# proyecto que ya ocupe el puerto estándar en tu máquina.
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
# Cada servicio arma su propia DATABASE_URL apuntando a su base:
# postgresql://eventhub:eventhub@localhost:5434/auth_db
# postgresql://eventhub:eventhub@localhost:5434/events_db
# postgresql://eventhub:eventhub@localhost:5434/tickets_db
# postgresql://eventhub:eventhub@localhost:5434/orders_db

# RabbitMQ
# Puerto host 5674/15674 (no 5672/15672) por la misma razón.
RABBITMQ_USER=eventhub
RABBITMQ_PASSWORD=eventhub
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5674
RABBITMQ_MGMT_PORT=15674
RABBITMQ_URL=amqp://eventhub:eventhub@localhost:5674

# Redis (reservas de tickets con TTL)
# Puerto host 6381 (no 6379) — ya ocupado por otros proyectos locales.
REDIS_HOST=localhost
REDIS_PORT=6381

# Auth / JWT (emitido por auth-service, validado por api-gateway)
JWT_SECRET=change-me-in-each-environment
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Header interno firmado — api-gateway lo emite, los servicios internos confían
# en él en vez de revalidar el JWT (Finding 3/9 del eng review).
INTERNAL_AUTH_SECRET=change-me-in-each-environment
