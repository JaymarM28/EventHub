# Postgres
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Cada servicio arma su propia DATABASE_URL apuntando a su base:
# postgresql://eventhub:eventhub@localhost:5432/auth_db
# postgresql://eventhub:eventhub@localhost:5432/events_db
# postgresql://eventhub:eventhub@localhost:5432/tickets_db
# postgresql://eventhub:eventhub@localhost:5432/orders_db

# RabbitMQ
RABBITMQ_USER=eventhub
RABBITMQ_PASSWORD=eventhub
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://eventhub:eventhub@localhost:5672

# Redis (reservas de tickets con TTL)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth / JWT (emitido por auth-service, validado por api-gateway)
JWT_SECRET=change-me-in-each-environment
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Header interno firmado — api-gateway lo emite, los servicios internos confían
# en él en vez de revalidar el JWT (Finding 3/9 del eng review).
INTERNAL_AUTH_SECRET=change-me-in-each-environment
